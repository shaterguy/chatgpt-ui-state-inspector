{
  "manifest_version": 3,
  "name": "ChatGPT UI State Inspector",
  "version": "0.1.3",
  "version_name": "0.1.3-dev7-structure-carrier",
  "description": "Record ChatGPT UI events, canonical turn states, and sanitized Work websocket protocol structure.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open ChatGPT UI State Inspector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel-dev7.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "lib/protocol.js",
        "lib/protocol-structure-carrier.js",
        "page-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "lib/core.js",
        "lib/turn-state.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
